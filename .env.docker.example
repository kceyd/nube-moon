# Copia este archivo como ".env" (junto a docker-compose.yml) y cambia los valores.
# Ojo: en el servidor crea el .env a mano; NO lo subas a GitHub.

# Clave del usuario root de MySQL (la usan los dos microservicios)
DB_PASS=cambia_esta_clave

# Secreto JWT: 32+ caracteres. Es el MISMO para ambos servicios (ya lo comparten por este archivo)
JWT_SECRET=pon-aqui-un-secreto-largo-de-minimo-32-caracteres

# Dirección desde donde se abre el frontend (con http://, sin "/" al final). Para varias, separa con coma.
# Local:  http://localhost:5173
# Nube:   http://TU-IP-O-DOMINIO-DEL-FRONTEND
CORS_ORIGINS=http://localhost:5173

# Clave del admin admin@moonsoon.cl (se crea al primer arranque)
ADMIN_PASSWORD=Admin123!
